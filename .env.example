# GariKhata app settings — the one place to point the app at a backend and
# other services. Copy this file to `.env` (git-ignored) and edit it.
#
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# VS Code's Run/Debug configs (.vscode/launch.json) pass it automatically.
# Values are compiled into the app: never put a server secret here.
# Restart the app (not hot reload) after changing a value.

# ── Backend ─────────────────────────────────────────────────────────────
# Empty                      → local dev server http://localhost:8001
# http://localhost:8001      → web/desktop; the Android emulator is sent to 10.0.2.2 automatically
# http://192.168.0.10:8001   → real phone on the same Wi-Fi (your computer's LAN IP)
# https://api.your-domain.com → production (release APKs only allow HTTPS
#                               besides localhost/10.0.2.2)
# origin                     → web build served by the backend under /app/
API_BASE_URL=https://garikhata.etalikhata.com

# Seconds before an API call gives up and the app treats it as offline.
API_TIMEOUT_SECONDS=20

# ── Google Drive backup ─────────────────────────────────────────────────
# OAuth client ids from Google Cloud Console (README → Google Drive setup).
# Leave empty until configured; the app then offers local file backup only.
GOOGLE_CLIENT_ID=1047174477474-fb5m6co3t9dm2lnrhv0qd288rj28qepj.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=1047174477474-fb5m6co3t9dm2lnrhv0qd288rj28qepj.apps.googleusercontent.com
