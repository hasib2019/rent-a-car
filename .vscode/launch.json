{
  // Every config loads the app settings from .env (copy .env.example first).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GariKhata",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=.env"]
    },
    {
      "name": "GariKhata (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=.env"]
    },
    {
      "name": "GariKhata (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=.env"]
    }
  ]
}
