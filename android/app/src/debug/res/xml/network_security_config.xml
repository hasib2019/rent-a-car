<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain HTTP is allowed to any host, so API_BASE_URL in
  .env can point at a laptop's LAN IP for testing on a real phone. Release
  builds use src/main/res/xml/network_security_config.xml (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
